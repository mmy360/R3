diff --git a/slime/utils/rollout_routing_replay.py b/slime/utils/rollout_routing_replay.py
new file mode 100644
index 0000000..5676887
--- /dev/null
+++ b/slime/utils/rollout_routing_replay.py
@@ -0,0 +1,157 @@
+import os  
+import hashlib  
+import requests  
+import torch  
+from typing import Optional, Tuple, List, Dict  
+  
+ROLLOUT_ROUTING_REPLAY_CACHE = None  
+  
+  
+def set_r3_cache(cache):  
+    global ROLLOUT_ROUTING_REPLAY_CACHE  
+    ROLLOUT_ROUTING_REPLAY_CACHE = cache  
+  
+class RolloutRoutingReplayCache:  
+    _instance = None  
+      
+    def __new__(cls, cache_server_url="http://0.0.0.0:8000"):  
+        if cls._instance is None:  
+            cls._instance = super().__new__(cls)  
+            cls._instance._initialized = False  
+        return cls._instance  
+      
+    def __init__(self, cache_server_url="http://0.0.0.0:8000"):  
+        if self._initialized:  
+            return  
+        self.cache_server_url = cache_server_url  
+        self.config = None  
+          
+        self.prefetched_data = {}  
+        self.current_layer = None
+        self.pop_count = 0
+        self._initialized = True  
+      
+    def _compute_hash_key(self, token_ids: List[int], prior_hash: Optional[str] = None) -> str:  
+        hasher = hashlib.sha256()  
+        if prior_hash:  
+            hasher.update(bytes.fromhex(prior_hash))  
+          
+        for t in token_ids:  
+            hasher.update(int(t).to_bytes(4, byteorder="little", signed=False))  
+          
+        return hasher.hexdigest()  
+      
+    def prefetch_all_layers(self, token_ids: List[int], config) -> bool:  
+        self.config = config  
+        last_hash = None  
+        hash_keys = []  
+        for token_id in token_ids:  
+            last_hash = self._compute_hash_key([token_id], prior_hash=last_hash)  
+            hash_keys.append(last_hash)  
+        
+        try:  
+            response = requests.post(  
+                f"{self.cache_server_url}/batch_get",  
+                json={"keys": hash_keys},  
+                timeout=10  
+            )  
+            
+            data_list = response.json().get("data", [])  
+            if not data_list:  
+                return False  
+            
+            num_layers = config.num_layers  
+            topk = config.moe_router_topk  
+            
+            template_data = next((data for data in data_list if data is not None), None)
+            if template_data is None:
+                return None, None      
+            for layer_id in range(1, num_layers + 1):
+                if layer_id not in self.prefetched_data:
+                    from collections import deque
+                    self.prefetched_data[layer_id] = deque()
+                batch_ids = torch.zeros(  
+                    (len(token_ids), topk),  
+                    dtype=torch.int64,  
+                    device="cpu",  
+                    pin_memory=True  
+                )  
+                batch_weights = torch.zeros(  
+                    (len(token_ids), topk),  
+                    dtype=torch.float32,  
+                    device="cpu",  
+                    pin_memory=True  
+                )  
+                none_num = 0
+                for i,  data in enumerate(data_list):  
+                    if data is None or set(data) == {0}:
+                        data = template_data
+                        none_num = none_num + 1
+                    ids_start = (layer_id - 1) * topk  
+                    ids_end = ids_start + topk  
+                    expert_ids = data[ids_start:ids_end]  
+                    
+                    weights_start = num_layers * topk + (layer_id - 1) * topk  
+                    weights_end = weights_start + topk  
+                    expert_weights = data[weights_start:weights_end]  
+                    
+                    batch_ids[i] = torch.tensor(expert_ids, dtype=torch.int64)  
+                    batch_weights[i] = torch.tensor(expert_weights, dtype=torch.float32)  
+                print(f"cache hit rate: {(len(data_list)-none_num)}/{len(data_list)} {(len(data_list)-none_num)/len(data_list)}")
+                self.prefetched_data[layer_id].append((batch_weights, batch_ids))  
+            return True  
+            
+        except Exception as e:  
+            print(f"❌ R3 Cache prefetch failed: {e}")  
+            import traceback  
+            traceback.print_exc()  
+            return False 
+
+
+    def pop_backward(self, layer_id):          
+        self.pop_count = self.pop_count + 1
+        batch_weights, batch_ids = self.prefetched_data[layer_id].popleft()  
+        return (  
+            batch_weights.to(torch.cuda.current_device()),  
+            batch_ids.to(torch.cuda.current_device())  
+        )  
+      
+    def clear_forward(self):  
+        for layer_id in self.forward_indices:  
+            self.forward_indices[layer_id] = 0  
+      
+    def clear(self):  
+        self.prefetched_data.clear()  
+      
+    @staticmethod  
+    def clear_all():  
+        if ROLLOUT_ROUTING_REPLAY_CACHE is not None:  
+            ROLLOUT_ROUTING_REPLAY_CACHE.clear()  
+
+def get_r3_cache_compute_topk(old_compute_topk):  
+    def compute_topk(scores, topk, num_groups=None, group_topk=None):  
+        if os.environ.get("ENABLE_R3_CACHE", "1") == "1":  
+            r3_stage = os.environ.get("ROUTING_REPLAY_STAGE", "fallthrough")  
+            layer_id = getattr(ROLLOUT_ROUTING_REPLAY_CACHE, 'current_layer', None) 
+
+            if r3_stage == "replay_backward":
+                probs, top_indices = ROLLOUT_ROUTING_REPLAY_CACHE.pop_backward(layer_id)  
+                return probs, top_indices  
+        return old_compute_topk(scores, topk, num_groups=num_groups, group_topk=group_topk)  
+    return compute_topk  
+  
+  
+def get_or_create_r3_cache(cache_server_url="http://0.0.0.0:8000"):  
+    global ROLLOUT_ROUTING_REPLAY_CACHE  
+    if ROLLOUT_ROUTING_REPLAY_CACHE is None:  
+        ROLLOUT_ROUTING_REPLAY_CACHE = RolloutRoutingReplayCache(cache_server_url)  
+    return ROLLOUT_ROUTING_REPLAY_CACHE  
+  
+  
+def register_r3_cache(module, cache_server_url="http://0.0.0.0:8000"):  
+    if os.environ.get("ENABLE_R3_CACHE", "0") == "1":  
+        module.r3_cache = get_or_create_r3_cache(cache_server_url)  
+        def pre_forward_hook(module, input):  
+            set_r3_cache(module.r3_cache)  
+            module.r3_cache.current_layer = module.layer_number  
+        module.register_forward_pre_hook(pre_forward_hook)
