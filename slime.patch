index 0000000..1c4451e
--- /dev/null
+++ b/run.py
@@ -0,0 +1,192 @@
+import asyncio, logging, multiprocessing, time
+from typing import Any, Dict
+from starlette.applications import Starlette
+from starlette.responses import JSONResponse, Response
+from starlette.routing import Route
+import uvicorn
+import orjson
+
+def loads(b: bytes) -> Any: return orjson.loads(b)
+def dumps(obj: Any) -> bytes: return orjson.dumps(obj)
+
+logger = logging.getLogger("srv")
+logging.basicConfig(level=logging.CRITICAL)
+
+_server_process = None
+_server_started = False
+
+class IdleMonitor:
+    def __init__(self, idle_timeout: float = 10.0):
+        self.idle_timeout = idle_timeout
+        self.last_request_time = time.time()
+        self.is_idle = False
+        self._task = None
+        self._event = asyncio.Event()
+        self._lock = asyncio.Lock()
+
+    def update_activity(self):
+        self.last_request_time = time.time()
+        if self.is_idle: self.is_idle = False
+        self._event.set()
+
+    async def monitor_idle(self):
+        while True:
+            try:
+                await asyncio.wait_for(self._event.wait(), timeout=self.idle_timeout)
+                self._event.clear()
+                if self.is_idle: self.is_idle = False
+            except asyncio.TimeoutError:
+                async with self._lock:
+                    if time.time() - self.last_request_time >= self.idle_timeout:
+                        if not self.is_idle: self.is_idle = True
+
+    def start_monitoring(self):
+        if self._task is None:
+            self._task = asyncio.create_task(self.monitor_idle())
+
+    def get_status(self):
+        return {
+            "is_idle": self.is_idle,
+            "idle_duration": round(time.time() - self.last_request_time, 2),
+            "idle_timeout": self.idle_timeout,
+            "last_request_time": round(self.last_request_time, 3)
+        }
+
+def _check_server_health(retries=3, delay=1.0) -> bool:
+    import requests
+    for _ in range(retries):
+        try:
+            if requests.get("http://127.0.0.1:8000/health", timeout=2).status_code == 200:
+                return True
+        except:
+            time.sleep(delay)
+    return False
+
+def _create_app(idle_timeout: float = 10.0) -> Starlette:
+    app = Starlette()
+    app.state.storage: Dict[str, Any] = {}
+    app.state.storage_lock = asyncio.Lock()
+    app.state.idle_monitor = IdleMonitor(idle_timeout)
+
+    async def startup():
+        app.state.idle_monitor.start_monitoring()
+    app.add_event_handler("startup", startup)
+
+    async def health(request):
+        return JSONResponse({"status": "healthy"})
+    app.add_route("/health", health, methods=["GET"])
+
+    async def idle_status(request):
+        return JSONResponse(app.state.idle_monitor.get_status())
+    app.add_route("/idle_status", idle_status, methods=["GET"])
+
+    async def batch_set(request):
+        app.state.idle_monitor.update_activity()
+        body = await request.body()
+        if not body:
+            return Response(content=dumps({"error": "empty"}), status_code=400, media_type="application/json")
+        try:
+            req = loads(body)
+            keys = req.get("keys", [])
+            data = req.get("data", [])
+        except:
+            return Response(content=dumps({"error": "invalid"}), status_code=400, media_type="application/json")
+        n = min(len(keys), len(data))
+        if n == 0: return {"results": []}
+        async with app.state.storage_lock:
+            for i in range(n): app.state.storage[keys[i]] = data[i]
+        return JSONResponse({"results": [{"key": keys[i], "ok": True} for i in range(n)]})
+
+    async def batch_get(request):
+        app.state.idle_monitor.update_activity()
+        body = await request.body()
+        if not body:
+            return Response(content=dumps({"error": "empty"}), status_code=400, media_type="application/json")
+        try:
+            req = loads(body)
+            keys = req.get("keys", [])
+        except:
+            return Response(content=dumps({"error": "invalid"}), status_code=400, media_type="application/json")
+        storage = app.state.storage
+        return JSONResponse({"data": [storage.get(k) for k in keys]})
+
+    async def batch_exists(request):
+        app.state.idle_monitor.update_activity()
+        body = await request.body()
+        if not body:
+            return Response(content=dumps({"error": "empty"}), status_code=400, media_type="application/json")
+        try:
+            req = loads(body)
+            keys = req.get("keys", [])
+        except:
+            return Response(content=dumps({"error": "invalid"}), status_code=400, media_type="application/json")
+        storage = app.state.storage
+        c = 0
+        for k in keys:
+            if k in storage: c += 1
+            else: break
+        return JSONResponse({"consecutive_hits": c})
+
+    async def clear_cache(request):
+        async with app.state.storage_lock:
+            app.state.storage.clear()
+        return JSONResponse({"status": "cleared"})
+        
+
+    app.add_route("/batch_set", batch_set, methods=["POST"])
+    app.add_route("/batch_get", batch_get, methods=["POST"])
+    app.add_route("/batch_exists", batch_exists, methods=["POST"])
+    app.add_route("/clear_cache", clear_cache, methods=["POST"])
+    
+    return app
+
+def run_server(host="0.0.0.0", port=8000, idle_timeout=10.0):
+    try:
+        import uvloop
+        asyncio.set_event_loop_policy(uvloop.EventLoopPolicy())
+    except:
+        pass
+    app = _create_app(idle_timeout)
+    config = uvicorn.Config(
+        app,
+        host=host,
+        port=port,
+        loop="asyncio",
+        workers=1,
+        lifespan="on",
+        access_log=False,
+        log_level="critical",
+        backlog=1048576
+    )
+    uvicorn.Server(config).run()
+
+def _start_server():
+    global _server_process, _server_started
+    if not _server_started:
+        _server_started = True
+        _server_process = multiprocessing.Process(
+            target=run_server,
+            daemon=True,
+            name="HiCache-HTTP-Server-Process",
+            kwargs={"host": "127.0.0.1", "port": 8000, "idle_timeout": 10.0}
+        )
+        _server_process.start()
+        for _ in range(10):
+            time.sleep(0.5)
+            if _check_server_health(retries=1, delay=0.1):
+                break
+        else:
+            if _server_process.is_alive():
+                _server_process.terminate()
+                _server_process.join(5)
+
+def stop_server():
+    global _server_process, _server_started
+    if _server_process and _server_process.is_alive():
+        _server_process.terminate()
+        _server_process.join(10)
+        if _server_process.is_alive(): _server_process.kill()
+        _server_started = False
+
+if __name__ == "__main__":
+    run_server()
