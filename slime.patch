@@ -0,0 +1,138 @@
+import os  
+import hashlib  
+import requests  
+import torch  
+from typing import Optional, Tuple, List  
+  
+ROLLOUT_ROUTING_REPLAY_CACHE = None  
+  
+  
+def set_r3_cache(cache):  
+    global ROLLOUT_ROUTING_REPLAY_CACHE  
+    ROLLOUT_ROUTING_REPLAY_CACHE = cache  
+  
+  
+class RolloutRoutingReplayCache:  
+    all_routing_cache = []  
+  
+    def __init__(self, cache_server_url="http://0.0.0.0:8000"):  
+        self.cache_server_url = cache_server_url  
+        self.token_ids = None  
+        self.layer_number = None  
+        self.config = None  
+        RolloutRoutingReplayCache.all_routing_cache.append(self)  
+  
+    def set_token_ids(self, 
+                      token_ids: List[int]):  
+        self.token_ids = token_ids  
+  
+    def _compute_hash_key(self, 
+                          token_ids: List[int], 
+                          prior_hash: Optional[str] = None) -> str:  
+        hasher = hashlib.sha256()  
+        if prior_hash:  
+            hasher.update(bytes.fromhex(prior_hash))  
+          
+        for t in token_ids:  
+            hasher.update(int(t).to_bytes(4, byteorder="little", signed=False))  
+          
+        return hasher.hexdigest()  
+  
+    def query_cache(self, 
+                    layer_number: int, 
+                    config) -> Tuple[Optional[torch.Tensor], Optional[torch.Tensor]]:  
+        if self.token_ids is None:  
+            return None, None  
+          
+        self.layer_number = layer_number  
+        self.config = config  
+          
+        last_hash = None  
+        hash_keys = []  
+        for token_id in self.token_ids:  
+            last_hash = self._compute_hash_key([token_id], prior_hash=last_hash)  
+            hash_keys.append(last_hash)  
+          
+        try:  
+            response = requests.post(  
+                f"{self.cache_server_url}/batch_get",  
+                json={"keys": hash_keys},  
+                timeout=5  
+            )  
+                
+            data_list = response.json().get("data", [])                
+            if not data_list:
+                return None, None
+                
+            valid_count = sum(1 for data in data_list if data is not None)
+            if valid_count == 0:
+                return None, None
+                
+            template_data = next((data for data in data_list if data is not None), None)
+            if template_data is None:
+                return None, None
+                
+            num_tokens = len(data_list)
+            half_len = len(template_data) // 2
+            num_layers = half_len // config.moe_router_topk
+            layer_idx = layer_number - 1
+            
+            layer_weights = torch.empty((num_tokens, config.moe_router_topk), dtype=torch.float32, device=torch.cuda.current_device())
+            layer_ids = torch.empty((num_tokens, config.moe_router_topk), dtype=torch.int64, device=torch.cuda.current_device())
+            
+            for i, data in enumerate(data_list):
+                if data is None or set(data) == {0}:
+                    data = template_data
+                start_idx = layer_idx * config.moe_router_topk
+                end_idx = start_idx + config.moe_router_topk
+                weights_start = half_len + start_idx
+                weights_end = half_len + end_idx
+                
+                layer_ids[i] = torch.tensor(data[start_idx:end_idx], dtype=torch.int64, device=layer_ids.device)
+                layer_weights[i] = torch.tensor(data[weights_start:weights_end], dtype=torch.float32, device=layer_weights.device)
+        
+            return layer_weights, layer_ids 
+        except Exception as e:  
+            print(f"Error querying R3 routing cache: {e}")  
+            return None, None  
+  
+    @staticmethod  
+    def clear_all():  
+        for cache in RolloutRoutingReplayCache.all_routing_cache:  
+            cache.token_ids = None  
+  
+  
+def get_r3_cache_compute_topk(old_compute_topk):  
+    def compute_topk(scores, topk, num_groups=None, group_topk=None):  
+        import os  
+        if os.environ.get("ENABLE_R3_CACHE", "1") == "1":  
+            if ROLLOUT_ROUTING_REPLAY_CACHE is not None:  
+                cached_probs, cached_top_indices = ROLLOUT_ROUTING_REPLAY_CACHE.query_cache(  
+                    layer_number=getattr(ROLLOUT_ROUTING_REPLAY_CACHE, 'current_layer', 0),  
+                    config=getattr(ROLLOUT_ROUTING_REPLAY_CACHE, 'config', None)  
+                )  
+                if cached_probs is not None and cached_top_indices is not None:  
+                    a,b = old_compute_topk(scores, topk, num_groups=num_groups, group_topk=group_topk) 
+                    print(f"✅ R3 Cache hit for layer {ROLLOUT_ROUTING_REPLAY_CACHE.current_layer}")  
+                    return cached_probs, cached_top_indices  
+
+        
+        return old_compute_topk(scores, topk, num_groups=num_groups, group_topk=group_topk)  
+      
+    return compute_topk  
+  
+  
+def register_r3_cache(module, cache_server_url="http://0.0.0.0:8000"):  
+    if os.environ.get("ENABLE_R3_CACHE", "1") == "1":  
+        module.r3_cache = RolloutRoutingReplayCache(cache_server_url)  
+  
+        def pre_forward_hook(module, input):  
+            set_r3_cache(module.r3_cache)  
+            from megatron.core.moe.cache_context import MoECacheContext  
+            token_ids = MoECacheContext.get_input_ids()  
+            if token_ids is not None:  
+                module.r3_cache.set_token_ids(token_ids)  
+            module.r3_cache.current_layer = module.layer_number  
+            module.r3_cache.config = module.config  
+  
+        module.register_forward_pre_hook(pre_forward_hook)
