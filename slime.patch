+import os  
+import torch  
+from sglang.srt.mem_cache.storage.mooncake_store.mooncake_store import MooncakeStore  
+from sglang.srt.mem_cache.hicache_storage import HiCacheStorageConfig  
+  
+def query_mooncake_key_and_ranks():  
+    """查询特定key及其在不同rank下的存在情况"""  
+      
+    # 初始化Mooncake存储  
+    storage_config = HiCacheStorageConfig(  
+        tp_size=1,  
+        tp_rank=0,  
+        is_mla_model=False,  
+        extra_config=None,
+        is_page_first_layout=True,
+        model_name=""
+    )  
+      
+    store = MooncakeStore(storage_config)  
+      
+    # 创建模拟内存池（注册用）  
+    buffer_size = 1024 * 1024  # 1MB  
+    buffer = torch.zeros(buffer_size, dtype=torch.float32)  
+      
+    class MockHostKVCache:  
+        def __init__(self, buffer):  
+            self.kv_buffer = buffer  
+            self.layout = "page_first_direct"  
+            self.page_size = 1  
+              
+        def get_page_buffer_meta(self, indices):  
+            ptr_list = []  
+            element_size_list = []  
+            for idx in indices:  
+                ptr_list.append(idx * 4)  
+                element_size_list.append(4)  
+            return ptr_list, element_size_list  
+      
+    mock_host_kv_cache = MockHostKVCache(buffer)  
+    store.register_mem_pool_host(mock_host_kv_cache)  
+      
+    # 用户提供的key  
+    target_key = "df3f619804a92fdb4057192dc43dd748ea778adc52bc498ce80524c014b81119_5_v"  
+      
+    # 解析基础hash和rank  
+    parts = target_key.split('_')  
+    base_hash = '_'.join(parts[:-2])  # 78e477474baa5fa636f1daaf3c7fc47a282107cec5058bd61490115c5eac08b2  
+    target_rank = parts[-2]           # 2  
