+            results = store.batch_get_v1(pending_keys, torch.tensor(pending_indices, dtype=torch.long))
+            batch_get_time = time.time() - batch_get_start
+
+            new_pending_keys = []
+            new_pending_indices = []
+            hit = 0
+
+            for k, idx, r in zip(pending_keys, pending_indices, results):
+                if r:
+                    hit += 1
+                else:
+                    new_pending_keys.append(k)
+                    new_pending_indices.append(idx)
+            
+            if hit == 0:
+                consecutive_zero_hits += 1
+            else:
+                consecutive_zero_hits = 0
+            
+            pending_keys = new_pending_keys
+            pending_indices = new_pending_indices
+            done_cnt = total_keys - len(pending_keys)
+
+            print(
+                f"[Round {round_id}] ✅ new hits = {hit}, \n"
+                f"\t\tdone = {done_cnt}/{total_keys}, \n"
+                f"\t\tmiss = {total_keys-done_cnt}/{total_keys}, \n"
+                f"\t\tbatch_get = {batch_get_time:.4f}s, \n"
+                f"\t\tconsecutive_zero = {consecutive_zero_hits}",
+                flush=True
+            )
+            if consecutive_zero_hits >= 2:
+                print(f"⚠️  Early stop: consecutive {consecutive_zero_hits} rounds with zero new hits")
+                break
+
+        print(f"⏱️ KV 全量获取完成，用时 {time.time() - get_start:.4f}s", flush=True)
+        if len(pending_keys) != 0:
+            for key in pending_keys:
+                print_to_file(key)
+        
+        store.clear()
+        process_start = time.time()
+        result_list = []
+        token_offset = 0
+        all_data_pages = host_kv_cache.kv_buffer[host_indices].squeeze(2)
+        dtype = all_data_pages.dtype
+        device = all_data_pages.device
+        expected_row = torch.arange(6, dtype=dtype, device=device)
+        for token_ids in token_ids_list:
+            n = len(token_ids)
+            token_data = all_data_pages[token_offset: token_offset + n - 1]
+            invalid_mask = (token_data != expected_row).any(dim=-1)  # shape: [n]
+
+            if invalid_mask.any():
+                token_data[invalid_mask] = expected_row
+
+            result_list.append(token_data)
+            token_offset += n
+
+        print(f"⏱️ 结果处理，用时 {time.time() - process_start:.4f}s", flush=True)
+        print(f"⏱️ 总用时 {time.time() - total_start:.4f}s", flush=True)
+        return result_list
 
