+    @staticmethod
+    def _compute_hash_key(token_ids: List[int], prior_hash: Optional[str] = None) -> str:
+        hasher = hashlib.sha256()
+        if prior_hash:
+            hasher.update(bytes.fromhex(prior_hash))
+        for t in token_ids:
+            hasher.update(int(t).to_bytes(4, byteorder="little", signed=False))
+        return hasher.hexdigest()
+
+    @staticmethod
+    async def _wait_for_idle(cache_server_url: str) -> bool:
+        async with aiohttp.ClientSession() as session:
+            while True:
+                try:
+                    async with session.get(
+                        f"{cache_server_url}/idle_status",
+                        timeout=aiohttp.ClientTimeout(total=1)
+                    ) as response:
+                        if response.status == 200:
+                            result = await response.json()
+                            if result.get("is_idle", False):
+                                return True
+                except:
+                    pass
+                await asyncio.sleep(5)
+
+    @staticmethod
+    async def _fetch_all_batches_single_request(
+        hash_keys_list: List[List[str]], 
+        cache_server_url: str
+    ) -> List[tuple]:
+        async with aiohttp.ClientSession() as session:
+            try:
+                batch_sizes = [len(keys) for keys in hash_keys_list]
+                all_keys = [key for keys in hash_keys_list for key in keys]
+                
+                payload = {"keys": all_keys}
+                async with session.post(
+                    f"{cache_server_url}/batch_get",
+                    json=payload,
+                    timeout=aiohttp.ClientTimeout(total=1000)
+                ) as response:
+                    result = await response.json()
+                    all_data = result.get("data", [])
+                    
+                    retry_keys = []
+                    retry_indices = []
+                    for idx, data in enumerate(all_data):
+                        if data is None:
+                            retry_keys.append(all_keys[idx])
+                            retry_indices.append(idx)
+                    
+                    if retry_keys:
+                        print(f"🔄 Retrying {len(retry_keys)} failed keys...")
+                        retry_payload = {"keys": retry_keys}
+                        async with session.post(
+                            f"{cache_server_url}/batch_get",
+                            json=retry_payload,
+                            timeout=aiohttp.ClientTimeout(total=1000)
+                        ) as retry_response:
+                            retry_result = await retry_response.json()
+                            retry_data = retry_result.get("data", [])
+                            
+                            for retry_idx, original_idx in enumerate(retry_indices):
+                                if retry_idx < len(retry_data) and retry_data[retry_idx] is not None:
+                                    all_data[original_idx] = retry_data[retry_idx]
+                    
+                    results = []
+                    start_idx = 0
+                    for batch_size in batch_sizes:
+                        batch_data = all_data[start_idx:start_idx + batch_size]
+                        start_idx += batch_size
+                        
+                        processed_data = []
+                        hit_count = 0
+                        for data in batch_data:
+                            if data is not None:
+                                tensor = torch.tensor(data, dtype=torch.float32)
+                                array = tensor.cpu().numpy()
+                                half = array.shape[0] // 2
+                                expert_indices = array[:half].astype(np.int32).reshape(-1, 6)
+                                processed_data.append(expert_indices)
+                                hit_count += 1
+                            else:
+                                processed_data.append(None)
+                        
+                        results.append((processed_data, hit_count))
+                    
+                    return results
+                    
+            except Exception as e:
+                print(f"❌ Batch fetch failed: {e}")
+                return [([None] * len(keys), 0) for keys in hash_keys_list]
+
+    @staticmethod
+    def prefetch_all_layers(
+        token_ids_list: List[List[int]], 
+        cache_server_url: str = "http://0.0.0.0:8000"
+    ) -> List[Optional[np.ndarray]]:
+        total_start_time = time.time()
+        
+        hash_keys_list = []
+        hash_key_start = time.time()
+        for token_ids in token_ids_list:
+            hash_keys = []
+            last_hash = None
+            for token_id in token_ids:
+                last_hash = RoutingReplay._compute_hash_key([token_id], prior_hash=last_hash)
+                hash_keys.append(last_hash)
+            hash_keys_list.append(hash_keys)
+        hash_key_time = time.time() - hash_key_start
+        
+        try:
+            print("⏳ Waiting for server idle...")
