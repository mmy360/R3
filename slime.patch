+   --ref-load /afs/chatrl/public/models/Moonlight-16B-A3B_torch_dist
+   --load /afs/chatrl/public/models/Moonlight-16B-A3B_torch_dist
+   --save $BASE_DIR/DeepSeek-R1_slime/
