+#         --num-gpus 8 \
+#         --disable-usage-stats \
+#         --dashboard-host=0.0.0.0 \
+#         --dashboard-port=8265
+# else
+#     ray start --address "${GEMINI_HOST_IP_taskrole1_0}:6379" --num-gpus 8 --disable-usage-stats
+# fi
+# if [ "$GEMINI_CURRENT_TASK_ROLE_CURRENT_TASK_INDEX" -eq 0 ]; then
+ray job submit --address="http://127.0.0.1:8265" \
+   --runtime-env-json='{
+   "env_vars": {
+      "no_proxy": "localhost,127.0.0.1,0.0.0.0",
