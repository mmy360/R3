+#!/bin/bash
+
+# for rerun the task
+pkill -9 sglang
+pkill -9 mooncake
+sleep 3
+ray stop --force
+pkill -9 ray
+pkill -9 python
+pkill -9 mooncake
+sleep 3
+pkill -9 ray
+pkill -9 python
+pkill -9 mooncake
+
+set -ex
+
+# will prevent ray from buffering stdout/stderr
+export PYTHONBUFFERED=0  
+# export GLOG_v=3  # 更详细的日志级别
+
+LOG_FILE="./mooncake_$(date +'%Y%m%d_%H%M%S').log" && mooncake_master  --rpc_thread_num=256  --default_kv_lease_ttl=300000  --eviction_high_watermark_ratio=0.6 &> "$LOG_FILE" &
+
+NVLINK_COUNT=$(nvidia-smi topo -m 2>/dev/null | grep -o 'NV[0-9][0-9]*' | wc -l)
+if [ "$NVLINK_COUNT" -gt 0 ]; then
+    HAS_NVLINK=1
+else
+    HAS_NVLINK=0
+fi
+echo "HAS_NVLINK: $HAS_NVLINK (detected $NVLINK_COUNT NVLink references)"
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
+source "${SCRIPT_DIR}/models/moonlight.sh"
+
+CKPT_ARGS=(
+   --hf-checkpoint /gemini/user/private/Moonlight-16B-A3B-Instruct
+   #--hf-checkpoint $BASE_DIR/DeepSeek-R1-bf16/
+   --ref-load /gemini/user/private/Moonlight-16B-A3B-Instruct_torch_dist
+   --load /gemini/user/private/Moonlight-16B-A3B-Instruct_torch_dist
+   # --save $BASE_DIR/DeepSeek-R1_slime/
+   # --save-interval 20
+)
+
+ROLLOUT_ARGS=(
+   --prompt-data /root/slime/data/test.jsonl
+   --input-key prompt
+   --label-key label
+   # --tokenizer-type TikTokenizer
+   # --tiktoken-pattern v2
+   # --tokenizer-model /gemini/space/infra/wxe/Moonlight-16B-A3B/tokenizer_config.json
+   --apply-chat-template
+   # --rollout-shuffle
+   --rm-type deepscaler
+   --num-rollout 400
+   --rollout-batch-size 1000
+   --n-samples-per-prompt 1
+   --rollout-max-response-len 7800
+   --rollout-temperature 0.8
+   --use-rollout-routing-replay 
+   # --use-slime-router
+   --over-sampling-batch-size 1000
+   # --dynamic-sampling-filter-path slime.rollout.filter_hub.dynamic_sampling_filters.check_reward_nonzero_std
+   --num-steps-per-rollout 1
+   # --balance-data
+)
+
+# EVAL_ARGS=(
+#    --eval-interval 20
+#    --eval-prompt-data dapo /afs/chatrl/users/wxe/slime/data/DAPO-Math-17k.jsonl
+#    --n-samples-per-eval-prompt 8
+#    --eval-max-response-len 4096
+#    --eval-top-p 0.7
+# )
+
+PERF_ARGS=(
+   --tensor-model-parallel-size 1
+   # --sequence-parallel
+   --pipeline-model-parallel-size 4
+   --context-parallel-size 4
+   --expert-model-parallel-size 1
+   --expert-tensor-parallel-size 1
+   --decoder-last-pipeline-num-layers 6
+   # --recompute-granularity full
+   # --recompute-method uniform
+   # --recompute-num-layers 1
+   # --use-dynamic-batch-size
+   # --max-tokens-per-gpu 16384
+)
+
+GRPO_ARGS=(
+   --advantage-estimator grpo
+   --use-kl-loss
+   --kl-loss-coef 0.00
+   --kl-loss-type low_var_kl
+   --entropy-coef 0.00
+   --eps-clip 0.2
+   --eps-clip-high 0.28
+)
+
+OPTIMIZER_ARGS=(
+   --optimizer adam
+   --lr 1e-6
+   --lr-decay-style constant
+   --weight-decay 0.1
+   --adam-beta1 0.9
+   --adam-beta2 0.98
+   --optimizer-cpu-offload
+   --overlap-cpu-optimizer-d2h-h2d
+   --use-precision-aware-optimizer
+)
+
+WANDB_ARGS=(
+   # --use-wandb
+   # --wandb-project slime-dev
+   # --wandb-group deepseek-r1-test
+   # --wandb-key ${WANDB_KEY}
+)
+
+TENSOR_BOARD_ARGS=(
+   --use-tensorboard 
+   --tb-project-name R3 
+   --tb-experiment-name R3_official_$(date +'%Y%m%d_%H%M%S')
+)
+
+SGLANG_ARGS=(
+   --rollout-num-gpus-per-engine 16
+   --sglang-mem-fraction-static 0.2
+   # dp attention
+   # --sglang-enable-dp-attention
+   # --sglang-enable-tokenizer-batch-encode 
+   # --sglang-disable-cuda-graph
+   --sglang-dp-size 1
+   --sglang-tp-size 16
+   --sglang-ep-size 16
+   # --sglang-moe-dense-tp-size 1
+   # --sglang-enable-dp-lm-head
+   # --sglang-disable-radix-cache
+   # --sglang-log-requests-level 3
+   # --sglang-log-requests
+   # --sglang-moe-a2a-backend deepep
+   # --sglang-enable-nan-detection
+   # enable deepep for sglang
+   # --sglang-enable-deepep-moe
+   # --sglang-deepep-mode auto
+   # make every dp rank has 128 concurrency
+   --sglang-server-concurrency 1000
+)
+
+MISC_ARGS=(
+   # default dropout in megatron is 0.1
+   --attention-dropout 0.0
+   --hidden-dropout 0.0
+   # should be good for model performance
+   --accumulate-allreduce-grads-in-fp32
+   --attention-softmax-in-fp32
+   # need to comment this when using model with MLA
+   --attention-backend flash
+   # --debug-rollout-only
+   # use deepep for megatron
+   # --moe-enable-deepep
+   # --moe-token-dispatcher-type flex
+   # --use-routing-replay
+   # --debug-rollout-only
+)
+
+# launch the master node of ray in container
+MASTER_ADDR="$(hostname -I | awk '{print $1}')"
+export MASTER_ADDR=${MASTER_ADDR:-"127.0.0.1"}
+ray start --head \
+          --node-ip-address ${MASTER_ADDR} \
+          --num-gpus 8 \
+          --disable-usage-stats \
+          --dashboard-host=0.0.0.0 \
+          --dashboard-port=8265
+
+RUNTIME_ENV_JSON="{
+  \"env_vars\": {
+    \"no_proxy\": \"localhost,127.0.0.1,0.0.0.0,${MASTER_ADDR}\",
+    \"MASTER_ADDR\": \"${MASTER_ADDR}\",  
+    \"PYTHONPATH\": \"/root/Megatron-LM/\",
+    \"CUDA_DEVICE_MAX_CONNECTIONS\": \"1\",
+    \"NCCL_NVLS_ENABLE\": \"${HAS_NVLINK}\",
+    \"MOONCAKE_MASTER\": \"${MASTER_ADDR}:50051\",
+    \"MOONCAKE_DEVICE\": \"mlx5_0,mlx5_3,mlx5_4,mlx5_5,mlx5_6,mlx5_8,mlx5_9,mlx5_10\",
+    \"MOONCAKE_PROTOCOL\": \"rdma\"
+  }
+}"
+
+ray job submit --address="http://127.0.0.1:8265" \
+   --runtime-env-json="${RUNTIME_ENV_JSON}" \
+   -- python3 train.py \
+   --actor-num-nodes 2 \
+   --actor-num-gpus-per-node 8 \
+   --colocate \
+   ${TENSOR_BOARD_ARGS[@]} \
+   ${MODEL_ARGS[@]} \
+   ${CKPT_ARGS[@]} \
+   ${ROLLOUT_ARGS[@]} \
+   ${OPTIMIZER_ARGS[@]} \
+   ${GRPO_ARGS[@]} \
+   ${WANDB_ARGS[@]} \
+   ${PERF_ARGS[@]} \
+   ${EVAL_ARGS[@]} \
+   ${SGLANG_ARGS[@]} \
+   ${MISC_ARGS[@]}
