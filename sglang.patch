diff --git a/python/sglang/srt/mem_cache/hiradix_cache.py b/python/sglang/srt/mem_cache/hiradix_cache.py
index 1691fe3..4ebb44b 100644
--- a/python/sglang/srt/mem_cache/hiradix_cache.py
+++ b/python/sglang/srt/mem_cache/hiradix_cache.py
@@ -944,3 +944,64 @@ class HiRadixCache(RadixCache):
         del self.ongoing_prefetch[rid]
         self.cache_controller.append_host_mem_release(host_indices[:completed_tokens])
         self.cache_controller.prefetch_tokens_occupied -= len(token_ids)
+
+class MoEHiRadixCache(HiRadixCache): 
+    def __init__(self, params, server_args):  
+        super().__init__(params, server_args)
+        
+    def cache_finished_req(self, req: Req, is_insert: bool = True):
+        token_ids = (req.origin_input_ids + req.output_ids)
+        kv_indices = self.req_to_token_pool.req_to_token[
+            req.req_pool_idx, : len(token_ids)
+        ]
+
+        values = kv_indices[: len(token_ids)].to(dtype=torch.int64, copy=True)
+        radix_key = RadixKey(token_ids, req.extra_key, is_bigram=self.is_eagle)
+
+        self.insert(radix_key, values, priority=0)
+        self.writing_check()
+        self.drain_storage_control_queues()
+
+    
+    def cache_unfinished_req(self, req: Req, chunked=False):
+        token_ids = req.fill_ids
+        kv_indices = self.req_to_token_pool.req_to_token[
+            req.req_pool_idx, : len(token_ids)
+        ]
+        values = kv_indices[: len(token_ids)].to(dtype=torch.int64, copy=True)
+        radix_key = RadixKey(token_ids, req.extra_key, is_bigram=self.is_eagle)
+        self.insert(
+            radix_key,
+            values,
+            chunked=chunked,
+            priority=0,
+        )
+        self.writing_check()
+        self.drain_storage_control_queues()
+
+
+    def wait_for_storage(self, timeout: Optional[float] = None) -> bool:    
+        start_time = time.monotonic()
+        while True:
+            self.writing_check()
+            self.drain_storage_control_queues()
+            
+            pending_operations = (
+                len(self.ongoing_backup) > 0 or
+                len(self.ongoing_write_through) > 0
+            )
+
+            if not pending_operations:
+                self.drain_storage_control_queues()
+                return True
+            
+            if timeout is not None and (time.monotonic() - start_time) > timeout:
+                remaining_backup = len(self.ongoing_backup)
+                remaining_write_through = len(self.ongoing_write_through)
+                logger.info(
+                    f"Storage wait timeout: {remaining_backup} backup, "
+                    f"{remaining_write_through} write-through operations pending"
+                )
+                return False
+            
+            time.sleep(0.001)  
