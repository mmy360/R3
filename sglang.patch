new file mode 100644
index 0000000..2455048
--- /dev/null
+++ b/run.py
@@ -0,0 +1,134 @@
+import asyncio
+import logging
+
+import multiprocessing
+import time
+from pydantic import BaseModel  
+from fastapi import FastAPI  
+
+import uvicorn
+import requests  
+from typing import List
+  
+logger = logging.getLogger(__name__)
+_server_process = None
+_server_started = False
+
+class BatchSetRequest(BaseModel):  
+    keys: List[str]  
+    data: List[List[float]]  
+  
+class BatchGetRequest(BaseModel):  
+    keys: List[str]  
+  
+class BatchExistsRequest(BaseModel):  
+    keys: List[str]  
+
+
+def _check_server_health(retries=3, delay=1):
+    for i in range(retries):
+        try:
+            response = requests.get("http://127.0.0.1:8000/health", timeout=5)
+            if response.status_code == 200:
+                return True
+        except requests.exceptions.RequestException:
+            if i < retries - 1:
+                time.sleep(delay)
+    return False
+
+def run_server():
+
+    try:
+        loop = asyncio.new_event_loop()
+        asyncio.set_event_loop(loop)
+        
+        app = FastAPI()
+        storage = {}
+        
+        @app.post("/batch_set")
+        async def batch_set(request : BatchSetRequest): 
+            results = []
+            for key, data in zip(request.keys, request.data):
+                storage[key] = data
+                print(data)
+            return {"results": results}
+        
+        @app.post("/batch_get")
+        async def batch_get(request: BatchGetRequest):  
+            data = [storage.get(key) for key in request.keys]
+            return {"data": data}
+        
+        @app.post("/batch_exists")
+        async def batch_exists(request :BatchExistsRequest): 
+            consecutive_hits = 0
+            for key in request.keys:
+                if key in storage:
+                    consecutive_hits += 1
+                else:
+                    break
+            return {"consecutive_hits": consecutive_hits}
+        
+        @app.get("/health")
+        async def health_check():
+            return {"status": "healthy"}
+        
+        config = uvicorn.Config(
+            app,
+            host="0.0.0.0",
+            port=8000,
+            loop="asyncio"
+        )
+        server = uvicorn.Server(config)
+        loop.run_until_complete(server.serve())
+    except Exception as e:
+        logger.error(f"Failed to start HTTP server in process: {e}")
+    finally:
+        if loop is not None:
+            loop.close()
+
+def _start_server():
+    global _server_process, _server_started
+    try:
+        if not _server_started:
+            _server_started = True
+            _server_process = multiprocessing.Process(
+                target=run_server,
+                daemon=True,
+                name="HiCache-HTTP-Server-Process"
+            )
+            
+            _server_process.start()
+            logger.info(f"Started HTTP server process with PID: {_server_process.pid}")
+            
+            for i in range(10):
+                time.sleep(0.5)
+                if _check_server_health(retries=1, delay=0.1):
+                    _server_started = True
+                    logger.info("HTTP server started successfully in separate process")
+                    break
+            else:
+                logger.error("HTTP server process failed to start within timeout")
+                if _server_process.is_alive():
+                    _server_process.terminate()
+                    _server_process.join(timeout=5)  
+                
+    except Exception as e:
+        logger.error(f"Error starting HTTP server process: {e}")
+        if _server_process and _server_process.is_alive():
+            _server_process.terminate()
+
+def stop_server():
+    global _server_process, _server_started
+    if _server_process and _server_process.is_alive():
